<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush"  Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush"   Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="ForegroundBrush"        Color="#FFEEEEEE"/>
    <SolidColorBrush x:Key="MutedForegroundBrush"   Color="#FFAAAAAA"/>
    <SolidColorBrush x:Key="AccentBrush"            Color="#FF60CDFF"/>
    <SolidColorBrush x:Key="BorderBrush"            Color="#FF3F3F3F"/>
    <SolidColorBrush x:Key="GoodBrush"              Color="#FF81C784"/>
    <SolidColorBrush x:Key="BadBrush"               Color="#FFEF5350"/>

</ResourceDictionary>
