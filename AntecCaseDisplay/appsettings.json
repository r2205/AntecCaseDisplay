{
  "cpu": {
    "sensorType": "Temperature",
    "namePattern": "^CPU \\(Tctl/Tdie\\)$|^CPU Package$|^Core \\(Tctl/Tdie\\)$|^CPU$",
    "aggregation": "Average",
    "scale": 1.0,
    "alertThreshold": 90.0
  },
  "gpu": {
    "sensorType": "Temperature",
    "namePattern": "^GPU Temperature$|^GPU$|^GPU Core$|^GPU Hot Spot$",
    "aggregation": "Average",
    "scale": 1.0,
    "alertThreshold": 85.0
  },
  "updateIntervalMs": 1000,
  "highPriority": true,
  "reconnectIntervalMs": 5000,
  "integerTemperatures": false,
  "alertsEnabled": true,
  "alertMinIntervalSeconds": 60,
  "loggingEnabled": false,
  "logPath": "antec-display.log",
  "theme": "System",
  "autoStartWithWindows": false,
  "startMinimized": true,
  "verbose": false,
  "dashboard": {
    "enabled": false,
    "alwaysOnTop": false,
    "borderless": true,
    "columns": 0,
    "historySeconds": 60,
    "hardwareColorMode": "Full",
    "hardwareColors": {
      "Cpu": "#3B82F6",
      "Gpu": "#22C55E",
      "Motherboard": "#8B5CF6",
      "Memory": "#14B8A6",
      "Storage": "#EC4899",
      "Network": "#84CC16",
      "Other": "#94A3B8"
    },
    "left": null,
    "top": null,
    "width": 820,
    "height": 480,
    "maximized": false,
    "items": []
  }
}
