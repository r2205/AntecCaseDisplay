<Application x:Class="AntecCaseDisplay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             xmlns:local="clr-namespace:AntecCaseDisplay"
             ShutdownMode="OnExplicitShutdown"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ModernWpf supplies Fluent ControlTemplates that honour the
                     current Light/Dark theme (driven by ModernWpf.ThemeManager).
                     Our own brushes are inlined into its ThemeDictionaries so
                     they swap together with the built-in ones. -->
                <ui:ThemeResources>
                    <ui:ThemeResources.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF6F6F6"/>
                            <SolidColorBrush x:Key="PanelBackgroundBrush"  Color="#FFFFFFFF"/>
                            <SolidColorBrush x:Key="ForegroundBrush"       Color="#FF1E1E1E"/>
                            <SolidColorBrush x:Key="MutedForegroundBrush"  Color="#FF666666"/>
                            <SolidColorBrush x:Key="AccentBrush"           Color="#FF0078D4"/>
                            <SolidColorBrush x:Key="BorderBrush"           Color="#FFCCCCCC"/>
                            <SolidColorBrush x:Key="GoodBrush"             Color="#FF2E7D32"/>
                            <SolidColorBrush x:Key="BadBrush"              Color="#FFC62828"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1E1E1E"/>
                            <SolidColorBrush x:Key="PanelBackgroundBrush"  Color="#FF2A2A2A"/>
                            <SolidColorBrush x:Key="ForegroundBrush"       Color="#FFEEEEEE"/>
                            <SolidColorBrush x:Key="MutedForegroundBrush"  Color="#FFAAAAAA"/>
                            <SolidColorBrush x:Key="AccentBrush"           Color="#FF60CDFF"/>
                            <SolidColorBrush x:Key="BorderBrush"           Color="#FF3F3F3F"/>
                            <SolidColorBrush x:Key="GoodBrush"             Color="#FF81C784"/>
                            <SolidColorBrush x:Key="BadBrush"              Color="#FFEF5350"/>
                        </ResourceDictionary>
                    </ui:ThemeResources.ThemeDictionaries>
                </ui:ThemeResources>
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- App-wide tweaks on top of ModernWpf's defaults. Text controls
                 pick up Foreground from the theme; ModernWpf handles the rest. -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            </Style>

            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="Margin" Value="0,3"/>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="MinWidth" Value="90"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
            </Style>

            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="Padding" Value="4,3"/>
            </Style>

            <Style TargetType="GroupBox">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <!-- tray icon resource -->
            <tb:TaskbarIcon x:Key="TrayIcon"
                            x:Shared="True"
                            ToolTipText="AntecCaseDisplay"
                            Visibility="Visible"
                            NoLeftClickDelay="True"
                            LeftClickCommand="{x:Static local:AppCommands.OpenSettingsCommand}">
                <tb:TaskbarIcon.IconSource>
                    <tb:GeneratedIconSource Text="A"
                                            Foreground="White"
                                            Background="#FF0078D4"
                                            FontWeight="Bold"
                                            FontSize="24"/>
                </tb:TaskbarIcon.IconSource>
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open settings…"
                                  Command="{x:Static local:AppCommands.OpenSettingsCommand}"
                                  FontWeight="Bold"/>
                        <MenuItem Header="Pause / Resume"
                                  Command="{x:Static local:AppCommands.PauseResumeCommand}"/>
                        <Separator/>
                        <MenuItem Header="Quit"
                                  Command="{x:Static local:AppCommands.QuitCommand}"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
