<Window x:Class="AntecCaseDisplay.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:AntecCaseDisplay.Dashboard"
        Title="AntecCaseDisplay — Dashboard"
        Width="820" Height="480" MinWidth="220" MinHeight="140"
        Background="{DynamicResource DashBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown"
        KeyDown="OnWindowKeyDown">

    <!-- Keep this window cheap to leave running: no AllowsTransparency (layered
         windows are composited on the CPU), no effects, no animations. The only
         per-tick work is a few TextBlock updates and one frozen geometry per
         sparkline. -->

    <Window.Resources>
        <!-- Resized with the window in code-behind (UpdateLayoutMetrics). -->
        <sys:Double x:Key="DashValueFontSize">40</sys:Double>
        <sys:Double x:Key="DashLabelFontSize">13</sys:Double>
        <sys:Int32 x:Key="DashColumns">1</sys:Int32>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:DashboardTile}">
            <Border Margin="5" Padding="16,10,16,12" CornerRadius="10"
                    Background="{DynamicResource DashTileBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                                   Text="{Binding RangeText}"
                                   ToolTip="Lowest – highest since HWiNFO's counters were last reset"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   FontSize="{DynamicResource DashLabelFontSize}"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Item.DisplaySource}"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   FontSize="{DynamicResource DashLabelFontSize}"
                                   FontWeight="SemiBold"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1" x:Name="ValueText" Margin="0,-2,0,0"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource ForegroundBrush}">
                        <Run Text="{Binding ValueText, Mode=OneWay}"
                             FontSize="{DynamicResource DashValueFontSize}"/><Run
                             Text="{Binding Unit, Mode=OneWay, StringFormat='&#x2009;{0}'}"
                             FontSize="{DynamicResource DashLabelFontSize}"
                             Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </TextBlock>

                    <local:Sparkline Grid.Row="2" x:Name="Spark" Margin="0,4,0,6"
                                     Samples="{Binding History}"
                                     Version="{Binding HistoryVersion}"
                                     FixedMin="{Binding ChartMin, Mode=OneTime}"
                                     FixedMax="{Binding ChartMax, Mode=OneTime}"
                                     Stroke="{DynamicResource DashAccentBrush}"/>

                    <Grid Grid.Row="3" Height="4"
                          Visibility="{Binding HasBar, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="2" Background="{DynamicResource DashTrackBrush}"/>
                        <Border x:Name="BarFill" CornerRadius="2"
                                Background="{DynamicResource DashAccentBrush}"
                                RenderTransformOrigin="0,0.5">
                            <!-- RenderTransform, not Width: moving the bar never re-runs layout. -->
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding BarFraction}"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:TileState.Warning}">
                    <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource DashWarnBrush}"/>
                    <Setter TargetName="Spark" Property="Stroke" Value="{DynamicResource DashWarnBrush}"/>
                    <Setter TargetName="BarFill" Property="Background" Value="{DynamicResource DashWarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:TileState.Critical}">
                    <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource DashCriticalBrush}"/>
                    <Setter TargetName="Spark" Property="Stroke" Value="{DynamicResource DashCriticalBrush}"/>
                    <Setter TargetName="BarFill" Property="Background" Value="{DynamicResource DashCriticalBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:TileState.Missing}">
                    <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                    <Setter TargetName="Spark" Property="Stroke" Value="{DynamicResource MutedForegroundBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem" Header="Always on top"
                      IsCheckable="True" Click="OnTopmostMenuClicked"/>
            <MenuItem x:Name="BorderlessMenuItem" Header="Borderless"
                      IsCheckable="True" Click="OnBorderlessMenuClicked"/>
            <MenuItem Header="Maximise / restore" InputGestureText="F11 or double-click"
                      Click="OnToggleMaximizeMenuClicked"/>
            <Separator/>
            <MenuItem Header="Settings…" Click="OnSettingsMenuClicked"/>
            <MenuItem Header="Close dashboard" Click="OnCloseMenuClicked"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="RootGrid" Margin="7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="StatusBanner" Grid.Row="0" Margin="5,5,5,0" Padding="12,6"
                CornerRadius="6" Background="{DynamicResource DashTileBrush}"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusBannerText" TextWrapping="Wrap"
                       Foreground="{DynamicResource DashWarnBrush}"/>
        </Border>

        <ItemsControl x:Name="TilesHost" Grid.Row="1"
                      ItemTemplate="{StaticResource TileTemplate}"
                      Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{DynamicResource DashColumns}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock x:Name="EmptyHint" Grid.Row="1"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="20"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Text="No readings on the dashboard yet.&#x0a;Right-click → Settings… and add some under “Dashboard window”."/>
    </Grid>
</Window>
